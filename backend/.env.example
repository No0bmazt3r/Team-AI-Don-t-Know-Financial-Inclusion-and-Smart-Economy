# The backend's settings: the API (backend/api) and the engine (backend/ml).
# Local: copy this file to backend/.env (git-ignored). Deployed: set the same names on the host (README → Deployment).
# Lines starting with # are optional; the value shown is the default. The app (frontend/) has its own .env.example.

# --- Server ---
# PORT=8000
# Leave empty to use the built-in local database (PGlite). On AWS, Terraform sets it to the RDS database (no password
# in it: ECS passes PGPASSWORD from the coinvoy/db secret). Any remote Postgres is reached over verified TLS.
# DATABASE_URL=
# Apply pending database migrations when the API starts (locally and on AWS).
# MIGRATE_ON_START=true
# The deployed commit, shown by /api/health. The AWS image has it built in; leave it unset.
# GIT_SHA=dev
# Port for opening the local database in DBeaver while the app runs. 0 turns it off.
# PGLITE_PORT=5433
APP_URL=http://localhost:5173
# Set to true when the site runs on https.
COOKIE_SECURE=false
SESSION_TTL_DAYS=7
# AUTH_RATE_PER_MIN=30
# Proxies in front of the API: 1 locally (the Vite dev server), 2 on AWS (CloudFront, then the load balancer).
# TRUST_PROXY=1
LOG_REQUESTS=true

# --- ML service (the engine) ---
# Locally `pnpm dev` runs it on port 8001; deployed it runs in the same container, on 127.0.0.1 only.
ML_URL=http://127.0.0.1:8001
# Optional shared secret between the API and the engine (the deployed container sets its own).
ML_TOKEN=
# Set to gbm to try the newer forecast model (only after it wins the real backtest).
# RATE_MODEL=
# BM_CLASSIFIER_THRESHOLD=0.7

# --- Sign-in ---
# From Google Cloud Console. Leave empty to use only the demo login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DEMO_ENABLED=true
# Google emails that can open /admin, separated by commas.
ADMIN_EMAILS=

# --- AI ---
# Providers, keys and models are managed in the app: sign in with an ADMIN_EMAILS account → Usage → AI keys.
# Each job (Snap, Odah Bot, lender check, BM parse, suggestions) has an ordered list of connections; a refused or
# rate-limited key hands the call to the next. Keys are stored encrypted with this master key:
#   openssl rand -base64 32
# Changing or losing it makes the stored keys unreadable: re-enter them in /admin/ai. Empty = AI off.
AI_KEYS_MASTER_KEY=

# Daily AI limits per rider, and a monthly limit for everyone.
# LLM_DAILY_SNAP=15
# LLM_DAILY_TANYA=20
# LLM_DAILY_LENDER=5
# LLM_DAILY_BM=30
# LLM_DAILY_RECO=10
# LLM_MONTHLY_CALL_CAP=20000
# LLM_TIMEOUT_S=60
# For demo day: remembers screenshot answers so a repeat works without the internet.
# DEMO_LLM_CACHE=false

# Email for data questions and complaints, shown on the privacy page.
PRIVACY_CONTACT_EMAIL=

# --- Payday reminder ---
# Make a key pair once with: pnpm --filter coinvoy-api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Government contributions (check these against the official sites before the pitch) ---
# ISARAAN_MATCH_RATE=0.2
# ISARAAN_MATCH_CAP_SEN=60000
# PERKESO_RATE=0.0125
# PERKESO_DEDUCTED_AT_SOURCE=true
